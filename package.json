{
    "name": "custom-buttons-context",
    "displayName": "Custom Buttons and Context Menus",
    "description": "Adds additional colorized buttons to the top bar, and custom commands to the right-click menu for HTML.",
    "version": "0.1.0",
    "publisher": "tpill90",
    "author":
    {
        "name": "Tim Pilius"
    },
    "repository":
    {
        "type": "git",
        "url": "https://github.com/tpill90/vscode-custom-buttons-context"
    },
    "license": "MIT",
    "engines":
    {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Keymaps"
    ],
    "main": "./out/extension.js",
    "scripts":
    {
        "watch": "tsc -watch -p ./",
        "package": "vsce package",
        "prepublish": "npm run compile"
    },
    "devDependencies":
    {
        "@types/node": "^26.4.0",
        "@types/vscode": "^1.80.0",
        "@vscode/vsce": "^3.0.0",
        "typescript": "^5.0.0"
    },
    "contributes":
    {
        "commands":
        [
            {
                "command": "emmet.removeTagContext",
                "title": "Remove Tag (Emmet)"
            },
            {
                "command": "emmet.wrapWithAbbreviation",
                "title": "Wrap With Tag (Emmet)"
            },
            {
                "command": "tpill90.saveAll",
                "title": "Save All",
                "icon": {
                    "light": "images/save.svg",
                    "dark": "images/save.svg"
                }
            },
            {
                "command": "tpill90.beautify",
                "title": "Beautify2",
                "icon": {
                    "light": "images/format.svg",
                    "dark": "images/format.svg"
                }
            },
            {
                "command": "tpill90.commentLine",
                "title": "Toggle line comment",
                "icon": {
                    "light": "images/commentLine.svg",
                    "dark": "images/commentLine.svg"
                }
            },
            {
                "command": "tpill90.startDebugging",
                "title": "Start debugging",
                "icon": {
                    "light": "images/debug.svg",
                    "dark": "images/debug.svg"
                }
            },
            {
                "command": "tpill90.removeEmptyLinesInSelection",
                "title": "Remove Empty Lines In Selection"
            },
            {
                "command": "tpill90.pasteJsonAsCode",
                "title": "Paste JSON As Code"
            }
        ],
        "menus":
        {
            "editor/context":
            [
                {
                    "command": "emmet.removeTagContext",
                    "when": "editorLangId == html || editorLangId == xml",
                    "group": "_1tpill90"
                },
                {
                    "command": "emmet.wrapWithAbbreviation",
                    "when": "editorLangId == html || editorLangId == xml",
                    "group": "_1tpill90"
                },
                {
                    "command": "tpill90.removeEmptyLinesInSelection",
                    "when": "editorHasSelection",
                    "group": "_1tpill90"
                },
                {
                    "command": "tpill90.pasteJsonAsCode",
                    "when": "editorTextFocus",
                    "group": "_1tpill90"
                }
            ],
            "editor/title":
            [
                {
                    "when": "!isInDiffEditor && !markdownPreviewFocus",
                    "command": "tpill90.saveAll",
                    "group": "navigation@4"
                },
                {
                    "when": "!isInDiffEditor && !markdownPreviewFocus",
                    "command": "tpill90.beautify",
                    "group": "navigation@4"
                },
                {
                    "when": "editorTextFocus && !editorReadonly",
                    "command": "tpill90.commentLine",
                    "group": "navigation@4"
                },
                {
                    "when": "debuggersAvailable && !inDebugMode",
                    "command": "tpill90.startDebugging",
                    "group": "navigation@4"
                }
            ]
        }
    },
    "files": [
        "out/**/*.js",
        "out/**/*.js.map",
        "images/*.svg",
        "package.json",
        "README.md",
        "LICENSE"
    ]
}
